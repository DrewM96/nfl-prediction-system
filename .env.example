# Obtain a key from https://the-odds-api.com/ and keep it out of source control.
ODDS_API_KEY=

# Owls is read exclusively from the process environment (not a .env loader).
OWLS_INSIGHT_API_KEY=
GRIDLINE_MARKET_PROVIDER=owls
# Optional: persistent shared local volume used by the worker and Streamlit.
# GRIDLINE_MARKET_DB=/var/lib/gridline/market.sqlite3

# Obtain a free key from https://collegefootballdata.com/key.
CFBD_API_KEY=
